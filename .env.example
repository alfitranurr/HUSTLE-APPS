# Copy to .env.local and fill in. Never commit real values.
# The app refuses to start if a required variable is missing or too weak.

# --- Supabase (auth, database, storage) --------------------------------------
# Dashboard > Project Settings > API. The URL and publishable key are public
# (they ship to the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only: it
# bypasses RLS and is used just to delete accounts and their files.
SUPABASE_SECRET_KEY=
# Postgres connection string (session pooler) for migrations, backups and
# psql checks from your machine. Not needed by the app or on Vercel.
SUPABASE_DB_URL=
