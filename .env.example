# Copy to .env.local and fill in. Never commit real values.
# The app refuses to start if a required variable is missing or too weak.

# --- Sign-in (single owner account) -----------------------------------------
# The only email allowed to sign in.
OWNER_EMAIL=
# Optional display name shown in the sidebar.
OWNER_NAME=
# At least 8 characters. Use a long, unique password.
LOGIN_PASSWORD=
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Google Sheets / Drive storage ------------------------------------------
# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Drive folder ID from https://drive.google.com/drive/folders/<ID> (attachments go here)
GOOGLE_DRIVE_FOLDER_ID=

# Option A (recommended): OAuth client + refresh token of the Drive owner
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B: service account JSON on a single line (used when Option A is empty)
GOOGLE_SERVICE_ACCOUNT_KEY=
